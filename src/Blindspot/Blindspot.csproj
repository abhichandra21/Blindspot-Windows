<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Window bounds must be in real pixels to line up with screen bounds. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Lets the app compile on the Mac; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>..\..\assets\Blindspot.ico</ApplicationIcon>
    <Product>Blindspot</Product>
    <Description>Warns when a Teams chat may be visible in your screen share</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The exe icon only exposes one size at run time; this keeps every size for the windows. -->
    <EmbeddedResource Include="..\..\assets\Blindspot.ico" LogicalName="Blindspot.ico" />
  </ItemGroup>

</Project>
